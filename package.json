{
  "name": "dsh-keeper",
  "version": "0.3.3",
  "description": "External lifecycle and compatibility manager for DeepSeek Harness",
  "type": "module",
  "bin": {
    "dshk": "dist/src/cli.js",
    "dsh-keeper": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist/src/**/*.js.map",
    "docs/**/*.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowanti/dsh-keeper.git"
  },
  "homepage": "https://github.com/nowanti/dsh-keeper#readme",
  "bugs": {
    "url": "https://github.com/nowanti/dsh-keeper/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin-manager",
    "compatibility",
    "upgrade",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "test:real-dsh": "pnpm build && node scripts/test-real-dsh.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev": "node --enable-source-maps dist/src/cli.js",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.1",
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2"
  }
}
